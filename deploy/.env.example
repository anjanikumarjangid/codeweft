# Repositories to serve: owner/name, Git URLs or paths, separated by spaces.
CODEWEFT_REPOS=acme/orders acme/payments
# Or every repository of an organization (needs GITHUB_TOKEN):
# CODEWEFT_GITHUB_ORG=acme

# Read access to the repositories' contents (fine-grained token).
GITHUB_TOKEN=
# The secret of the GitHub webhook (push events) pointing at /webhooks/github.
GITHUB_WEBHOOK_SECRET=
# Tokens your developers' MCP clients send, separated by commas.
# Generate one with: openssl rand -hex 32
CODEWEFT_API_TOKENS=

# Or, or as well: people sign in with GitHub and see what their account can
# read. Create a GitHub App (or OAuth App) with the callback URL
# <CODEWEFT_PUBLIC_URL>/oauth/callback.
# CODEWEFT_PUBLIC_URL=https://codeweft.example.com
# CODEWEFT_GITHUB_CLIENT_ID=
# CODEWEFT_GITHUB_CLIENT_SECRET=

# CODEWEFT_SYNC_INTERVAL=10m

# Optional: keep indexes in PostgreSQL instead of SQLite files on the
# volume, e.g. to run several replicas.
# CODEWEFT_DATABASE_URL=postgres://codeweft:password@db:5432/codeweft
